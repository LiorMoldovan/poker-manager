# Dependencies
node_modules/

# Build output
dist/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Local Vercel
.vercel

# Dev scripts (may contain tokens)
scripts/*

# ...except the prompt-quality harness, which is a committed regression tool.
# Its out/ holds generated prompts, model responses and run logs — never commit those.
!scripts/promptlab/
scripts/promptlab/out/

# ...and the settlement harness, same deal: invariants.mjs is the correctness
# gate for the payout engine, analyze.mjs reports payout quality on real games.
!scripts/settlelab/
scripts/settlelab/out/

# Cursor MCP config (contains Supabase PAT)
.cursor/mcp.json
